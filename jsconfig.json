{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "module": "commonjs",
    "target": "es2022",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "maxNodeModuleJsDepth": 0,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/**/*.js"
  ]
}